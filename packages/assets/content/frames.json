[
  {
    "id": "frame:barrel",
    "kind": "frame",
    "schemaVersion": 1,
    "title": "BARREL",
    "style": "wood_parchment",
    "presentation": {
      "surface": "entity",
      "entityContainer": "placeable"
    },
    "resizable": true,
    "panes": [
      {
        "id": "contents",
        "kind": "slots",
        "label": "CONTENTS",
        "columns": 5,
        "rows": 2,
        "bind": {
          "entitySlots": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ]
        },
        "restriction": {
          "acceptedFrom": {
            "stationTag": "container.barrel",
            "role": "input"
          }
        }
      },
      {
        "id": "backpack",
        "kind": "slots",
        "label": "INVENTORY",
        "columns": 5,
        "rows": 4,
        "sizing": "flex",
        "bind": {
          "self": "backpack"
        }
      }
    ],
    "buttons": [
      {
        "label": "SEAL",
        "interaction": "seal",
        "tone": "success",
        "visibleWhen": {
          "state": "sealed",
          "equals": false
        }
      }
    ],
    "hotbar": {
      "label": "HOT BAR"
    }
  },
  {
