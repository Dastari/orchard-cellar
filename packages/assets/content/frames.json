  {
    "id": "frame:cooking",
    "kind": "frame",
    "schemaVersion": 1,
    "title": "COOKING FIRE",
    "style": "wood_parchment",
    "presentation": {
      "surface": "entity",
      "entityContainer": "placeable"
    },
    "resizable": true,
    "panes": [
      {
        "id": "input",
        "kind": "slots",
        "label": "RAW FOOD",
        "columns": 1,
        "rows": 1,
        "bind": {
          "entitySlots": [
            0
          ]
        },
        "restriction": {
          "acceptedFrom": {
            "stationTag": "station.campfire",
            "role": "input"
          }
        }
      },
      {
        "id": "progress",
        "kind": "bar",
        "label": "PROGRESS",
        "minWidth": 18,
        "bind": {
          "process": "progress"
        }
      },
      {
        "id": "output",
        "kind": "slots",
        "label": "COOKED FOOD",
        "columns": 1,
        "rows": 1,
        "bind": {
          "entitySlots": [
            1
          ]
        },
        "restriction": {
          "readOnly": true
        }
      },
      {
        "id": "backpack",
        "kind": "slots",
        "label": "INVENTORY",
        "columns": 5,
        "rows": 4,
        "sizing": "flex",
        "bind": {
          "self": "backpack"
        }
      },
      {
        "id": "pending_job",
        "kind": "label",
        "label": "PENDING COOKING",
        "bind": {
          "state": "processJobLabel"
        },
        "visibleWhen": {
          "state": "processJobPending",
          "equals": true
        }
      },
      {
        "id": "pending_job_progress",
        "kind": "bar",
        "label": "BATCH PROGRESS",
        "bind": {
          "state": "processJobProgress"
        },
        "visibleWhen": {
          "state": "processJobPending",
          "equals": true
        }
      }
    ],
    "buttons": [
      {
        "label": "COLLECT BATCH",
        "interaction": "collect_job",
        "onInvoke": {
          "claimProcessJob": "collect"
        },
        "tone": "success",
        "visibleWhen": {
          "state": "processJobReady",
          "equals": true
        }
      },
      {
        "label": "CANCEL BATCH",
        "interaction": "cancel_job",
        "onInvoke": {
          "claimProcessJob": "cancel"
        },
        "tone": "danger",
        "visibleWhen": {
          "state": "processJobPending",
          "equals": true
        }
      }
    ],
    "hotbar": {
      "label": "HOT BAR"
    }
  },
