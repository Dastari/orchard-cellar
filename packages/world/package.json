{
  "name": "@orchard/world",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash ../../scripts/spacetime-build-checked.sh",
    "generate": "spacetime generate --lang typescript --out-dir ../world-bindings/src --module-path . --yes",
    "publish:local": "npm --prefix ../.. run world:release",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orchard/lifecycle-authoring": "*",
    "@orchard/sim": "*",
    "spacetimedb": "2.8.2"
  },
  "devDependencies": {
    "typescript": "~5.6.2"
  }
}
