# Public values embedded by `vite build`; never put secrets in a VITE_* variable.
VITE_SPACETIMEDB_PRODUCTION_URI=https://cellar.dastari.net
# Optional local-live choice in Studio; production builds normally leave this unset
# so the local choice remains same-origin through the protected proxy.
VITE_SPACETIMEDB_LOCAL_URI=https://cellar.dastari.net
VITE_SPACETIMEDB_DATABASE=orchard-cellar-world
VITE_OIDC_CLIENT_ID=orchard-studio
VITE_OIDC_ISSUER=https://auth.orchard.dastari.net/realms/orchard
VITE_OIDC_REDIRECT_URI=https://cellar.dastari.net/
VITE_ENABLE_LOCAL_PROFILES=false
