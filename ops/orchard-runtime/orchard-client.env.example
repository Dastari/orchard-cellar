# Public values embedded by `vite build`; never put secrets in a VITE_* variable.
VITE_SPACETIMEDB_URI=https://orchard.dastari.net
VITE_SPACETIMEDB_DATABASE=orchard-cellar-world
VITE_OIDC_CLIENT_ID=orchard-web
VITE_OIDC_ISSUER=https://auth.orchard.dastari.net/realms/orchard
VITE_OIDC_REDIRECT_URI=https://orchard.dastari.net/
VITE_ENABLE_LOCAL_PROFILES=false
