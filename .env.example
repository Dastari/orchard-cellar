# Browser connection
VITE_SPACETIMEDB_URI=http://localhost:3000
VITE_SPACETIMEDB_DATABASE=orchard-cellar-world

# Register this exact redirect URI in the SpacetimeAuth client dashboard.
# The client ID is public; never put a client secret in the browser environment.
VITE_OIDC_CLIENT_ID=
VITE_OIDC_ISSUER=https://auth.spacetimedb.com/oidc
VITE_OIDC_REDIRECT_URI=http://localhost:5173/account.html
