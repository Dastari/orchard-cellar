# Browser connection
VITE_SPACETIMEDB_URI=http://localhost:3000
VITE_SPACETIMEDB_DATABASE=orchard-cellar-world

# Production uses Keycloak Authorization Code + PKCE. The client ID is public;
# never put a client secret in the browser environment. Local profile tokens are
# available only when both Vite DEV mode and this explicit flag are enabled.
# Leave empty for local-profile development. If local OIDC callback testing is
# needed, create a separate orchard-web-dev client; never add localhost to orchard-web.
VITE_OIDC_CLIENT_ID=
VITE_OIDC_ISSUER=https://auth.orchard.dastari.net/realms/orchard
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
VITE_ENABLE_LOCAL_PROFILES=true
