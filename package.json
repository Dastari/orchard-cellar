{
  "name": "orchard-cellar",
  "version": "0.38.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run assets:build && concurrently -k -n world-host,world,client,assets -c magenta,blue,green,yellow \"npm run world:host\" \"npm run world:dev\" \"VITE_SPACETIMEDB_DATABASE=${ORCHARD_DEV_DATABASE:-orchard-cellar-dev} npm run dev -w @orchard/client\" \"npm run watch -w @orchard/tools\"",
    "build": "npm run assets:build && npm run pwa:assets && npm run build -w @orchard/sim && npm run build -w @orchard/tools && npm run build -w @orchard/world && npm run build -w @orchard/client && npm run build -w @orchard/studio",
    "check": "npm run lifecycle:integrity && npm run content:validate && npm run build -w @orchard/world && npm run typecheck && npm run lint && npm test && npm run assets:validate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test:coverage && npm run test:exhaustive",
    "test:coverage": "vitest run --coverage --exclude packages/sim/src/procedural-terrain.test.ts --exclude packages/sim/src/survival-world.test.ts --exclude packages/tools/src/hearth-village-access.test.ts --exclude packages/studio/src/tools/map/editor-terrain-build.test.ts --exclude packages/ui/src/kit/runtime/app-performance.test.ts --exclude packages/studio/src/tools/build-canvas.test.ts --exclude packages/studio/src/tools/map/selection-inspection.test.ts",
    "test:exhaustive": "vitest run packages/sim/src/procedural-terrain.test.ts packages/sim/src/survival-world.test.ts packages/tools/src/hearth-village-access.test.ts packages/studio/src/tools/map/editor-terrain-build.test.ts packages/ui/src/kit/runtime/app-performance.test.ts packages/studio/src/tools/build-canvas.test.ts packages/studio/src/tools/map/selection-inspection.test.ts --no-file-parallelism",
    "assets:validate": "npm run validate -w @orchard/tools",
    "assets:build": "npm run atlas -w @orchard/tools && npm run ui:assets -w @orchard/tools",
    "client:chunks:check": "tsx scripts/check-client-build-chunks.ts",
    "assets:render": "npm run render -w @orchard/tools --",
    "assets:preview": "npm run preview -w @orchard/tools",
    "music:render": "npm run music:render -w @orchard/tools --",
    "assets:import": "npm run import -w @orchard/tools --",
    "assets:restore-native": "npm run restore-native -w @orchard/tools",
    "pwa:assets": "npm run pwa:assets -w @orchard/tools",
    "login:background": "tsx packages/tools/src/render-login-island.ts && npm run extract:keycloak-theme -w @orchard/tools && npm run pwa:assets",
    "sim:pace": "tsx packages/tools/src/pace-sim.ts",
    "content:export": "npm run content:export -w @orchard/tools",
    "content:validate": "npm run content:validate -w @orchard/tools",
    "content:measure": "npm run content:measure -w @orchard/tools",
    "content:db-measure": "tsx scripts/content-database-measure.ts",
    "world:content-head": "tsx scripts/content-head-release.ts",
    "content:load:acceptance": "bash scripts/run-content-load-acceptance.sh",
    "lifecycle:verify": "tsx scripts/lifecycle-code-build.ts verify",
    "lifecycle:build": "tsx scripts/lifecycle-code-build.ts build",
    "lifecycle:integrity": "tsx scripts/lifecycle-artifact-integrity.ts",
    "world:state-parity": "npm run world:state-parity -w @orchard/tools --",
    "world:release:typecheck": "tsc -p scripts/tsconfig.release.json",
    "world:rejoin-smoke": "tsx scripts/world-rejoin-smoke.ts",
    "world:stage-a:acceptance": "tsx scripts/stage-a-acceptance.ts",
    "world:placeable:acceptance": "tsx scripts/placeable-interaction-acceptance.ts",
    "world:chest-migrate": "tsx scripts/chest-migration-runner.ts",
    "world:farm-retirement": "tsx scripts/legacy-farm-retirement-runner.ts",
    "terrain:seed-map": "npm run seed-map -w @orchard/tools --",
    "world:host": "spacetime start --listen-addr 127.0.0.1:3000 --data-dir .spacetime-data --non-interactive",
    "world:dev": "bash scripts/world-dev.sh",
    "world:procedural-publish": "spacetime publish orchard-cellar-procedural-dev --server local --module-path packages/world --delete-data=never --yes=remote,migrate,break-clients",
    "world:release": "bash scripts/world-release.sh",
    "world:release:routine": "bash scripts/world-release-routine.sh",
    "world:release:dry-run": "WORLD_RELEASE_DRY_RUN=true bash scripts/world-release.sh",
    "world:release:finalize": "bash scripts/world-release-finalize.sh",
    "world:retirement:prepare": "bash scripts/prepare-chest-retirement-candidate.sh",
    "world:release:retire-chests": "bash scripts/world-release-retire-chests.sh",
    "world:restore-rehearsal": "bash ops/orchard-runtime/bin/restore-world-rehearsal.sh",
    "client:static:validate": "bash ops/orchard-runtime/bin/validate-client-static.sh",
    "studio:static:validate": "bash ops/orchard-runtime/bin/validate-studio-static.sh",
    "studio:build": "npm run build -w @orchard/studio --",
    "world:smoke": "tsx scripts/world-smoke.ts",
    "world:auth-smoke": "tsx scripts/auth-world-smoke.ts",
    "world:load": "spacetime publish orchard-cellar-netcode-load --server local --module-path packages/world --yes --delete-data && tsx scripts/netcode-load.ts",
    "world:scalability-stage2": "tsx scripts/scalability-stage2.ts",
    "world:crash-ghost": "spacetime publish orchard-cellar-netcode-crash --server local --module-path packages/world --yes --delete-data && SPACETIMEDB_DATABASE=orchard-cellar-netcode-crash tsx scripts/netcode-crash-ghost.ts",
    "world:action-check": "spacetime publish orchard-cellar-netcode-action --server local --module-path packages/world --yes --delete-data && SPACETIMEDB_DATABASE=orchard-cellar-netcode-action tsx scripts/netcode-action.ts",
    "world:tap-check": "spacetime publish orchard-cellar-netcode-tap --server local --module-path packages/world --yes --delete-data && SPACETIMEDB_DATABASE=orchard-cellar-netcode-tap tsx scripts/netcode-tap.ts",
    "actions:baseline": "npm run actions:baseline -w @orchard/tools --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "1.0.8",
    "@noble/hashes": "2.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.0.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
